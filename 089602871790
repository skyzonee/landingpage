            content.innerHTML = `
                <div class="p-10">
                    <div class="flex justify-between items-start mb-10">
                        <div>
                            <span class="text-yellow-400 text-[10px] font-black uppercase tracking-[0.4em] block mb-2 glow-yellow">AI GAME FINDER ✨</span>
                            <h3 class="text-3xl font-[900] uppercase italic tracking-tighter">CARI GAME MOOD ANDA</h3>
                        </div>
                        <button onclick="closeModal()" class="p-2 rounded-xl bg-white/5 text-gray-500 hover:text-white transition-colors"><i data-lucide="x" class="w-6 h-6"></i></button>
                    </div>
                    <div class="space-y-6">
                        <div class="flex flex-wrap gap-2 mb-4">
                            ${['Seru Berdua', 'Open World', 'Horor Mencekam', 'Sangat Kompetitif', 'Nostalgia'].map(m => `
                                <button onclick="setMood('${m}')" class="px-4 py-2 rounded-full border border-white/10 text-[10px] font-black uppercase hover:border-yellow-400/50 hover:bg-yellow-400/10 transition-all">${m}</button>
                            `).join('')}
                        </div>
                        <input id="mood-input" type="text" class="w-full bg-black/40 border border-white/10 rounded-2xl px-6 py-5 focus:border-yellow-400 outline-none font-bold text-sm text-yellow-400" placeholder="Ketik game atau mood anda...">
                        <div id="ai-result" class="hidden bg-yellow-400/5 border border-white/5 rounded-3xl p-6 min-h-[100px] flex flex-col items-center justify-center text-center">
                            <div class="loader mb-4" id="ai-loader"></div>
                            <p id="ai-result-text" class="text-gray-300 text-xs leading-relaxed italic mb-6"></p>
                            <div id="ai-action-btn" class="hidden"></div>
                        </div>
                        <button id="ai-btn" onclick="getRecommendation()" class="w-full bg-yellow-400 text-black py-5 rounded-2xl font-[900] text-xs uppercase tracking-widest active:scale-95 transition-all shadow-xl">TANYA ASISTEN ✨</button>
                    </div>
                </div>
            `;
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function setMood(m) {
            document.getElementById('mood-input').value = m;
        }

        async function getRecommendation() {
            const input = document.getElementById('mood-input').value;
            if (!input) return;

            const btn = document.getElementById('ai-btn');
            const resultBox = document.getElementById('ai-result');
            const loader = document.getElementById('ai-loader');
            const text = document.getElementById('ai-result-text');
            const actionBtn = document.getElementById('ai-action-btn');

            btn.disabled = true;
            resultBox.classList.remove('hidden');
            loader.classList.remove('hidden');
            actionBtn.classList.add('hidden');
            text.innerText = "";

            const systemPrompt = `Anda adalah Asisten SkyZone. Tugas anda merekomendasikan unit berdasarkan mood/game. 
            Data Unit & Game: 
            - PS5: FC 25, God of War, Elden Ring, Tekken 8.
            - PS4 Pro: PES 2026, GTA V, WWE 2K25.
            - Switch: Mario Kart, Zelda, Mario Wonder.
            Berikan jawaban singkat & gaul. Selalu akhiri dengan kode unik [ACTION:ID] jika anda merekomendasikan salah satu, ganti ID dengan ps5, ps4-vip, atau switch.`;
            
            try {
                const res = await callGemini(`Rekomendasikan game untuk: ${input}`, systemPrompt);
                
                let cleanText = res.replace(/\[ACTION:(\w+-\w+|\w+)\]/g, (match, id) => {
                    const unit = CONSOLES.find(c => c.id === id);
                    if (unit) {
                        actionBtn.innerHTML = `<button onclick="startBooking('${id}')" class="bg-white text-black px-8 py-3 rounded-xl font-black text-[10px] uppercase shadow-lg">Booking ${unit.name} Sekarang</button>`;
                        actionBtn.classList.remove('hidden');
                    }
                    return "";
                });
                
                text.innerText = cleanText;
            } catch (err) {
                text.innerText = "Koneksi ke server gaming sedang sibuk...";
            } finally {
                loader.classList.add('hidden');
                btn.disabled = false;
            }
        }

        async function onBookingUpdate() {
            updateTotal();
            const tipText = document.getElementById('ai-tip-text');
            const tipLoader = document.getElementById('ai-tip-loader');
            if (!tipText) return;
            tipLoader.classList.remove('hidden');
            tipText.innerText = "...";
            const dur = document.getElementById('form-duration').value;
            try {
                const prompt = `Saya sewa ${selectedConsole.name} selama ${dur} jam. Berikan 1 saran singkat aktivitas seru.`;
                const tip = await callGemini(prompt, "Saran singkat gaming.");
                tipText.innerText = tip;
            } catch (e) {
                tipText.innerText = "Nikmati pengalaman bermain terbaik!";
            } finally {
                tipLoader.classList.add('hidden');
            }
        }

        const formatIDR = (num) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num);

        function scrollToFleet() {
            const fleet = document.getElementById('fleet');
            if (fleet) fleet.scrollIntoView({ behavior: 'smooth' });
            else { showSection('home'); setTimeout(() => document.getElementById('fleet').scrollIntoView({ behavior: 'smooth' }), 100); }
        }

        function startCarousel() {
            const track = document.getElementById('slider-track');
            const dotsContainer = document.getElementById('slider-dots');
            const items = document.querySelectorAll('.slide-item');
            if (!track) return;
            const updateCarousel = () => {
                const itemWidth = items[0].offsetWidth;
                const gap = 32; 
                const containerWidth = document.getElementById('slider-container').offsetWidth;
                const offset = (containerWidth / 2) - (itemWidth / 2) - (currentSlide * (itemWidth + gap));
                track.style.transform = `translateX(${offset}px)`;
                items.forEach((item, index) => { index === currentSlide ? item.classList.add('active') : item.classList.remove('active'); });
                const dots = dotsContainer.querySelectorAll('div');
                dots.forEach((dot, i) => { dot.className = i === currentSlide ? "h-1.5 rounded-full transition-all duration-500 w-10 bg-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.5)]" : "h-1.5 rounded-full transition-all duration-500 w-2 bg-white/20"; });
            };
            window.addEventListener('resize', updateCarousel);
            updateCarousel();
            setInterval(() => {
                if (!document.getElementById('slider-track')) return;
                currentSlide = (currentSlide + 1) % GAME_POSTERS.length;
                updateCarousel();
            }, 4000);
        }

        function viewGames(id) {
            const console = CONSOLES.find(c => c.id === id);
            const modal = document.getElementById('modal-container');
            const content = document.getElementById('modal-content');
            content.innerHTML = `
                <div class="p-10">
                    <div class="flex justify-between items-start mb-10">
                        <div>
                            <span class="text-yellow-400 text-[10px] font-black uppercase tracking-[0.4em] block mb-2 glow-yellow">MASTER GAME LIST</span>
                            <h3 class="text-3xl font-[900] uppercase italic tracking-tighter">${console.name}</h3>
                        </div>
                        <button onclick="closeModal()" class="p-2 rounded-xl bg-white/5 text-gray-500 hover:text-white transition-colors"><i data-lucide="x" class="w-6 h-6"></i></button>
                    </div>
                    <div class="grid grid-cols-1 gap-3 max-h-[50vh] overflow-y-auto pr-2">
                        ${console.gameList.map((g, i) => `
                            <div class="flex items-center gap-5 bg-white/5 p-5 rounded-2xl border border-white/5 group hover:border-yellow-400/20 transition-all">
                                <span class="text-xs font-black text-yellow-400/30 w-6">${(i+1).toString().padStart(2, '0')}</span>
                                <span class="text-xs font-black uppercase tracking-widest text-gray-300 group-hover:text-white">${g}</span>
                            </div>
                        `).join('')}
                    </div>
                    <button onclick="closeModal()" class="w-full mt-10 bg-white text-black py-5 rounded-2xl font-[900] text-xs uppercase tracking-widest active:scale-95 transition-all shadow-xl">TUTUP DAFTAR</button>
                </div>
            `;
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeModal() { document.getElementById('modal-container').classList.add('hidden'); }
        function startBooking(id) { closeModal(); selectedConsole = CONSOLES.find(c => c.id === id); bookingData = { name: '', duration: 1, startTime: '12:00' }; showSection('booking'); }
        function updateTotal() { const dur = parseInt(document.getElementById('form-duration').value); document.getElementById('display-total').innerText = formatIDR(selectedConsole.price * dur); }
        function confirmBooking() { const name = document.getElementById('form-name').value.trim(); if (!name) { alert('MOHON INPUT NAMA PEMESAN!'); return; } bookingData.name = name; bookingData.duration = parseInt(document.getElementById('form-duration').value); bookingData.startTime = document.getElementById('form-time').value; showSection('success'); }
        function sendWA(id) { const total = selectedConsole.price * bookingData.duration; const msg = `Halo SKYZONE! Reservasi:%0A*ID:* ${id}%0A*Nama:* ${bookingData.name}%0A*Unit:* ${selectedConsole.name}%0A*Durasi:* ${bookingData.duration} Jam%0A*Mulai:* ${bookingData.startTime}%0A*Total:* ${formatIDR(total)}`; window.open(`https://wa.me/6289678541684?text=${msg}`, '_blank'); }

        init();
    </script>
</body>
</html>
