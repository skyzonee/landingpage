    <style>
        body {
            background-color: #070b14;
            color: white;
            -webkit-font-smoothing: antialiased;
        }

        .glow-yellow {
            text-shadow: 0 0 15px rgba(250, 204, 21, 0.5);
        }

        /* Carousel Slider Optimization */
        #slider-container {
            perspective: 1000px;
            mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
            -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
        }

        .slider-track {
            display: flex;
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            gap: 2rem;
            padding: 2rem 0;
        }

        .slide-item {
            flex: 0 0 260px;
            height: 380px;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            filter: grayscale(1) blur(4px);
            opacity: 0.2;
            transform: scale(0.8) rotateY(5deg);
            border-radius: 2.5rem;
            overflow: hidden;
            position: relative;
        }

        @media (min-width: 768px) {
            .slide-item { flex: 0 0 320px; height: 460px; }
        }

        .slide-item.active {
            filter: grayscale(0) blur(0);
            opacity: 1;
            transform: scale(1.05) rotateY(0deg);
            box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 30px rgba(250,204,21,0.15);
            border: 1px solid rgba(250,204,21,0.4);
            z-index: 10;
        }

        .card-hover-glow:hover {
            box-shadow: 0 0 40px rgba(250, 204, 21, 0.1);
            border-color: rgba(250, 204, 21, 0.3);
            transform: translateY(-5px);
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #070b14; }
        ::-webkit-scrollbar-thumb { background: #1e2538; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #facc15; }

        @keyframes slideInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-up { animation: slideInUp 0.8s cubic-bezier(0.2, 1, 0.3, 1) forwards; }

        .loader {
            border: 3px solid rgba(250, 204, 21, 0.1);
            border-top: 3px solid #facc15;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(3600deg); } /* Fast spin for UI feel */
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
